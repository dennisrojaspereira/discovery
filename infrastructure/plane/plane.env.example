# ============================================================
# Plane CE — ambiente local do CTO Discovery Lab
# Baseado em deployments/cli/community/variables.env (makeplane/plane)
# Copiado para plane.env pelo `lab.sh bootstrap` (com segredos gerados).
# Plane fica acessível em http://localhost:8080
# ============================================================

APP_DOMAIN=localhost:8080
APP_RELEASE=stable

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

# Porta externa do proxy do Plane (interno continua 80)
LISTEN_HTTP_PORT=8080
LISTEN_HTTPS_PORT=8443

WEB_URL=http://localhost:8080
DEBUG=0
CORS_ALLOWED_ORIGINS=http://localhost:8080
API_BASE_URL=http://api:8000

# DB SETTINGS (postgres interno do Plane, isolado do postgres do MedAgenda)
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# REDIS SETTINGS
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=
REDIS_SSL_CERT_REQS=required
REDIS_SSL_CA_CERTS=

# RabbitMQ Settings
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=

# Proxy / certificados (sem TLS em localhost)
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_DNS=

# Segredos — o lab.sh bootstrap substitui por valores aleatórios
SECRET_KEY=__GENERATED_BY_BOOTSTRAP__
LIVE_SERVER_SECRET_KEY=__GENERATED_BY_BOOTSTRAP__

# DATA STORE SETTINGS (MinIO interno)
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=plane-minio-access
AWS_SECRET_ACCESS_KEY=__GENERATED_BY_BOOTSTRAP__
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

GUNICORN_WORKERS=1
MINIO_ENDPOINT_SSL=0
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
NUM_PROXIES=

WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=
