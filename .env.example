# ============================================================
# CTO Discovery Lab — variáveis de ambiente (exemplo)
# Copie para .env e ajuste. NUNCA commite o .env real.
# ============================================================

# ---------- PostgreSQL (infra compartilhada) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab_local_dev_only
POSTGRES_DB=medagenda

# ---------- MedAgenda API ----------
MEDAGENDA_API_PORT=3002
DATABASE_URL=postgresql://lab:lab_local_dev_only@localhost:5432/medagenda?schema=public
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# ---------- MedAgenda Web ----------
MEDAGENDA_WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3002

# ---------- Mattermost ----------
MATTERMOST_URL=http://localhost:8065
MATTERMOST_ADMIN_USER=sysadmin
MATTERMOST_ADMIN_PASSWORD=Sysadmin123!
# Token do bot Discovery Bot (gerado pelo bootstrap em .lab-state/)
MATTERMOST_BOT_TOKEN=
MATTERMOST_TEAM=medagenda

# ---------- Forgejo ----------
FORGEJO_URL=http://localhost:3000
FORGEJO_ADMIN_USER=labadmin
FORGEJO_ADMIN_PASSWORD=Labadmin123!
FORGEJO_ADMIN_EMAIL=labadmin@local.test
# Token gerado pelo bootstrap em .lab-state/
FORGEJO_TOKEN=
FORGEJO_ORG=medagenda
FORGEJO_REPO=cto-discovery-lab

# ---------- Plane ----------
PLANE_URL=http://localhost:8080
# API key criada em Workspace Settings > API Tokens (passo manual na UI)
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=medagenda
